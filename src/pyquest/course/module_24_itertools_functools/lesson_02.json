      ]
    },
    {
      "id": "m24l2e2",
      "prompt": {
        "es": "Define `fib(n)` (Fibonacci) usando recursión y `@lru_cache` para memoizar. fib(0)=0, fib(1)=1.",
        "en": "Define `fib(n)` (Fibonacci) using recursion and `@lru_cache` to memoize. fib(0)=0, fib(1)=1."
      },
      "starter_code": [
        "from functools import lru_cache",
        "",
        "@lru_cache",
        "def fib(n):",
        "    pass"
      ],
      "solution": [
        "from functools import lru_cache",
        "",
        "@lru_cache",
        "def fib(n):",
        "    return n if n < 2 else fib(n-1) + fib(n-2)"
      ],
      "hints": {
        "es": [
          "Caso base n<2 devuelve n; si no, fib(n-1)+fib(n-2)."
        ],
        "en": [
          "Base case n<2 returns n; otherwise fib(n-1)+fib(n-2)."
        ]
      },
      "tests": [
        {
