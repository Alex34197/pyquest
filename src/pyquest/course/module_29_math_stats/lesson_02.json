          "type": "function",
          "function": "media",
          "cases": [
            {
              "args": [
                [
                  1,
                  2,
                  3
                ]
              ],
              "expected": 2
            },
            {
              "args": [
                [
                  1,
                  2
                ]
              ],
              "expected": 1.5
            }
          ]
        }
      ]
    },
    {
