    {
      "id": "m40l1e2",
      "prompt": {
        "es": "Define `mergesort(lista)` que ordene de forma recursiva con la técnica de mezcla.",
        "en": "Define `mergesort(lista)` sorting recursively with the merge technique."
      },
      "starter_code": [
        "def mergesort(lista):",
        "    pass"
      ],
      "solution": [
        "def mergesort(lista):",
        "    if len(lista) <= 1:",
        "        return list(lista)",
        "    medio = len(lista) // 2",
        "    izq = mergesort(lista[:medio])",
        "    der = mergesort(lista[medio:])",
        "    r, i, j = [], 0, 0",
        "    while i < len(izq) and j < len(der):",
        "        if izq[i] <= der[j]:",
        "            r.append(izq[i]); i += 1",
        "        else:",
        "            r.append(der[j]); j += 1",
        "    return r + izq[i:] + der[j:]"
      ],
      "hints": {
        "es": [
          "Caso base len<=1; divide por la mitad, ordena cada mitad y mezcla."
        ],
        "en": [
          "Base case len<=1; split in half, sort each half and merge."
        ]
      },
      "tests": [
        {
          "type": "function",
          "function": "mergesort",
          "cases": [
            {
              "args": [
                [
                  3,
                  1,
                  2
                ]
              ],
              "expected": [
                1,
                2,
                3
              ]
            },
            {
              "args": [
                []
              ],
              "expected": []
            },
            {
              "args": [
                [
                  5,
                  4,
                  3,
                  2,
                  1
                ]
              ],
              "expected": [
                1,
                2,
                3,
                4,
                5
              ]
            }
          ]
        }
      ]
    }
  ]
