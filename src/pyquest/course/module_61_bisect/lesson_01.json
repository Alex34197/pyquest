      "prompt": {
        "es": "Define `posicion(ordenada, x)` que devuelva el índice donde iría `x` (usa bisect_left).",
        "en": "Define `posicion(ordenada, x)` returning the index where `x` would go (use bisect_left)."
      },
      "starter_code": [
        "import bisect",
        "",
        "def posicion(ordenada, x):",
        "    pass"
      ],
      "solution": [
        "import bisect",
        "",
        "def posicion(ordenada, x):",
        "    return bisect.bisect_left(ordenada, x)"
      ],
