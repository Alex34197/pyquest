    {
      "id": "m63l1e2",
      "prompt": {
        "es": "Define `parejas(a, b)` que devuelva todas las combinaciones [x, y] con x de `a` e y de `b` (usa product).",
        "en": "Define `parejas(a, b)` returning all combinations [x, y] with x from `a` and y from `b` (use product)."
      },
      "starter_code": [
        "from itertools import product",
        "",
        "def parejas(a, b):",
        "    pass"
      ],
      "solution": [
        "from itertools import product",
        "",
        "def parejas(a, b):",
        "    return [list(p) for p in product(a, b)]"
      ],
      "hints": {
        "es": [
          "product(a, b) da tuplas; conviértelas a lista."
        ],
        "en": [
          "product(a, b) yields tuples; convert them to lists."
        ]
      },
      "tests": [
        {
          "type": "function",
          "function": "parejas",
          "cases": [
            {
              "args": [
                [
                  1,
                  2
                ],
                [
                  "a",
                  "b"
                ]
              ],
              "expected": [
                [
                  1,
                  "a"
                ],
                [
                  1,
                  "b"
                ],
                [
                  2,
                  "a"
                ],
                [
                  2,
                  "b"
                ]
              ]
            },
            {
              "args": [
                [
                  1
                ],
                [
                  "x"
                ]
              ],
