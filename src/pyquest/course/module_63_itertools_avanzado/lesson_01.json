{
  "id": "m63l1",
  "title": {
    "es": "accumulate y product",
    "en": "accumulate and product"
  },
  "theory": {
    "es": [
      {
        "type": "heading",
        "value": "Sumas acumuladas y combinaciones"
      },
      {
        "type": "text",
        "value": "`itertools.accumulate(iterable)` da las sumas acumuladas (running totals). `itertools.product(a, b)` da el producto cartesiano: todas las parejas posibles."
      },
      {
        "type": "code",
        "value": [
          "from itertools import accumulate, product",
          "print(list(accumulate([1, 2, 3, 4])))",
          "print(list(product([1, 2], ['a', 'b'])))"
        ]
      },
      {
        "type": "output",
        "value": [
          "[1, 3, 6, 10]",
          "[(1, 'a'), (1, 'b'), (2, 'a'), (2, 'b')]"
        ]
      },
      {
        "type": "note",
        "value": "product evita bucles anidados; accumulate sirve para totales progresivos (saldos, distancias)."
      }
    ],
    "en": [
      {
        "type": "heading",
        "value": "Running totals and combinations"
      },
      {
        "type": "text",
        "value": "`itertools.accumulate(iterable)` gives running totals. `itertools.product(a, b)` gives the cartesian product: all possible pairs."
      },
      {
        "type": "code",
        "value": [
          "from itertools import accumulate, product",
          "print(list(accumulate([1, 2, 3, 4])))",
          "print(list(product([1, 2], ['a', 'b'])))"
        ]
      },
      {
        "type": "output",
        "value": [
          "[1, 3, 6, 10]",
          "[(1, 'a'), (1, 'b'), (2, 'a'), (2, 'b')]"
        ]
      },
      {
        "type": "note",
        "value": "product avoids nested loops; accumulate is great for progressive totals (balances, distances)."
      }
    ]
  },
  "exercises": [
    {
      "id": "m63l1e1",
      "prompt": {
        "es": "Define `acumulado(nums)` que devuelva las sumas acumuladas (usa itertools.accumulate).",
        "en": "Define `acumulado(nums)` returning the running totals (use itertools.accumulate)."
      },
      "starter_code": [
        "from itertools import accumulate",
        "",
        "def acumulado(nums):",
        "    pass"
      ],
      "solution": [
        "from itertools import accumulate",
        "",
        "def acumulado(nums):",
        "    return list(accumulate(nums))"
      ],
      "hints": {
