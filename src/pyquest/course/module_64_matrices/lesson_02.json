    {
      "id": "m64l2e2",
      "prompt": {
        "es": "Define `aplanar(m)` que convierta la matriz en una sola lista (fila a fila).",
        "en": "Define `aplanar(m)` turning the matrix into a single list (row by row)."
      },
      "starter_code": [
        "def aplanar(m):",
