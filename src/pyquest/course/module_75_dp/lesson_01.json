    {
      "id": "m75l1e2",
      "prompt": {
        "es": "Define `monedas(cantidad, valores)`: mínimo nº de monedas para sumar `cantidad`; -1 si es imposible.",
        "en": "Define `monedas(cantidad, valores)`: minimum number of coins to make `cantidad`; -1 if impossible."
      },
      "starter_code": [
        "def monedas(cantidad, valores):",
        "    pass"
      ],
      "solution": [
        "def monedas(cantidad, valores):",
        "    INF = float('inf')",
        "    dp = [0] + [INF] * cantidad",
        "    for i in range(1, cantidad + 1):",
        "        for v in valores:",
        "            if v <= i and dp[i - v] + 1 < dp[i]:",
        "                dp[i] = dp[i - v] + 1",
        "    return dp[cantidad] if dp[cantidad] != INF else -1"
      ],
      "hints": {
        "es": [
          "Tabla dp donde dp[i] = mínimo de monedas para la cantidad i."
        ],
        "en": [
          "DP table where dp[i] = minimum coins for amount i."
        ]
      },
      "tests": [
        {
          "type": "function",
          "function": "monedas",
          "cases": [
            {
              "args": [
                11,
                [
                  1,
                  2,
                  5
                ]
              ],
              "expected": 3
            },
            {
              "args": [
                0,
                [
                  1
                ]
              ],
              "expected": 0
            },
            {
              "args": [
                3,
                [
                  2
                ]
              ],
              "expected": -1
            }
          ]
        }
      ]
    }
  ]
